# ----- OpenAI (generation + embeddings) -----
OPENAI_API_KEY=sk-...

# Model used to generate grounded answers (streaming)
OPENAI_CHAT_MODEL=gpt-4o-mini
# Embedding model. text-embedding-3-small = 1536 dims (matches QDRANT_VECTOR_SIZE below)
OPENAI_EMBED_MODEL=text-embedding-3-small

# ----- Qdrant Cloud (vector store) -----
# From your Qdrant Cloud cluster dashboard
QDRANT_URL=https://xxxxxxxx.eu-central.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# Collection names (created automatically on first run)
QDRANT_CHUNKS_COLLECTION=notebook_chunks
QDRANT_ENTITIES_COLLECTION=notebook_entities
# Must match the embedding model's dimensionality (1536 for text-embedding-3-small)
QDRANT_VECTOR_SIZE=1536

# ----- RAG tuning (optional; sensible defaults applied) -----
CHUNK_SIZE=1100          # target characters per chunk
CHUNK_OVERLAP=180        # character overlap between adjacent chunks
RETRIEVAL_TOP_K=6        # chunks retrieved per query
