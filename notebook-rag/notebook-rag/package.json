    "reindex:all": "tsx --env-file=.env scripts/reindex-all.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.19.0",
    "@vercel/functions": "3.10.1",
    "cheerio": "^1.0.0",
    "next": "^14.2.35",
    "next-auth": "5.0.0-beta.32",
    "openai": "^4.67.3",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
