{
  "name": "notebook-rag",
  "version": "1.0.0",
  "private": true,
  "description": "An AI research assistant with a full RAG pipeline: multi-source ingestion, grounded answers, and inspectable citations.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
